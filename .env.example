PORT=3000

# ECS SSH
SSH_HOST=your-ecs-ip
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=replace_with_real_password
# Optional: use private key auth instead of password
# SSH_PRIVATE_KEY_PATH=/app/keys/id_rsa
# SSH_PASSPHRASE=optional_passphrase

# Managed services, comma separated
MANAGED_SERVICES=nginx,docker,ssh
# Optional: managed containers whitelist (comma separated).
# Leave empty to allow managing all containers.
MANAGED_CONTAINERS=

# Optional basic auth for panel (strongly recommended for public exposure)
PANEL_USERNAME=admin
PANEL_PASSWORD=replace_with_panel_password

# Optional: public URL when panel is behind Nginx reverse proxy
# PANEL_PUBLIC_HOST=your-domain.com
# PANEL_PUBLIC_PATH=/ops/ecs-manage/
